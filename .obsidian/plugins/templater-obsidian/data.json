    {
      "regex": "^Parties/[^/]+/Party\\.md$",
      "template": "_system/templates/party.md"
    },
    {
      "regex": "^Parties/[^/]+/(?!Party\\.md$)[^/]+\\.md$",
      "template": "_system/templates/pc.md"
    },
    {
      "regex": "^Library/Mechanics/[^/]+/Spells/",
