{
  "data_version": 2,
  "command_timeout": 5,
  "templates_folder": "_system/templates",
  "templates_pairs": [],
  "trigger_on_file_creation_mode": "regex",
  "auto_jump_to_cursor": true,
  "jump_to_cursor_after_file_name": false,
  "shell_path": "",
  "user_scripts_folder": "_system/scripts",
  "folder_templates": [],
  "file_templates": [
    {
      "regex": "^Worlds/[^/]+/World\\.md$",
      "template": "_system/templates/world.md"
    },
    {
      "regex": "^Worlds/[^/]+/NPCs/",
      "template": "_system/templates/npc.md"
    },
    {
      "regex": "^Worlds/[^/]+/Locations/",
      "template": "_system/templates/location.md"
    },
    {
      "regex": "^Worlds/[^/]+/Factions/",
      "template": "_system/templates/faction.md"
    },
    {
      "regex": "^Worlds/[^/]+/Lore/",
      "template": "_system/templates/lore.md"
    },
    {
      "regex": "^Worlds/[^/]+/Events/",
      "template": "_system/templates/event.md"
    },
    {
      "regex": "^Campaigns/[^/]+/NPCs/",
      "template": "_system/templates/npc.md"
    },
    {
      "regex": "^Campaigns/[^/]+/Locations/",
      "template": "_system/templates/location.md"
    },
    {
      "regex": "^Campaigns/[^/]+/Quests/",
      "template": "_system/templates/quest.md"
    },
    {
      "regex": "^Campaigns/[^/]+/Factions/",
      "template": "_system/templates/faction.md"
    },
    {
      "regex": "^Campaigns/[^/]+/Lore/",
      "template": "_system/templates/lore.md"
    },
    {
      "regex": "^Campaigns/[^/]+/Events/",
      "template": "_system/templates/event.md"
    },
    {
      "regex": "^Campaigns/[^/]+/Encounters/",
      "template": "_system/templates/encounter.md"
    },
    {
      "regex": "^Campaigns/[^/]+/Handouts/",
      "template": "_system/templates/handout.md"
    },
    {
      "regex": "^Runs/[^/]+/Run\\.md$",
      "template": "_system/templates/run.md"
    },
    {
      "regex": "^Runs/[^/]+/[^/]+\\.md$",
      "template": "_system/templates/session.md"
    },
    {
      "regex": "^Campaigns/[^/]+/Campaign\\.md$",
      "template": "_system/templates/campaign.md"
    },
    {
      "regex": "^Parties/[^/]+/Party\\.md$",
      "template": "_system/templates/party.md"
    },
    {
      "regex": "^Parties/[^/]+/(?!Party\\.md$)[^/]+\\.md$",
      "template": "_system/templates/pc.md"
    },
    {
      "regex": "^Library/Mechanics/[^/]+/Spells/",
      "template": "_system/templates/spell.md"
    },
    {
      "regex": "^Library/Mechanics/[^/]+/Bestiary/",
      "template": "_system/templates/creature.md"
    },
    {
      "regex": "^Library/Mechanics/[^/]+/Items/",
      "template": "_system/templates/item.md"
    },
    {
      "regex": "^Library/Mechanics/[^/]+/Rules/",
      "template": "_system/templates/rules.md"
    }
  ],
  "syntax_highlighting": true,
  "syntax_highlighting_mobile": false,
  "enabled_templates_hotkeys": [],
  "startup_templates": [],
  "intellisense_render": "1",
  "ignore_folders_on_creation": [
    {
      "folder": "_system"
    },
    {
      "folder": "_local"
    },
    {
      "folder": ".gmvault"
    }
  ],
  "trigger_on_file_creation": true
}
