{
  "release": {
    "repo": "jakrog01/GMVault",
    "asset": "GMVault.zip",
    "api": "https://api.github.com"
  },
  "releaseInclude": [
    "_system",
    "_local",
    ".obsidian",
    ".gmvault/plugin-build.json",
    "Parties",
    "Runs",
    "Library",
    "Calendar",
    "Archive",
    "Active.md",
    "Home.md",
    ".gitignore"
  ],
  "releaseExclude": [
    ".obsidian/workspace.json",
    ".obsidian/workspace-mobile.json",
    ".obsidian/plugins/table-tools/data.json"
  ],
  "contentRoots": [
    "Parties",
    "Runs",
    "Library",
    "Calendar",
    "Archive"
  ],
  "ownedGlobs": [
    "_system/**",
    ".obsidian/**",
    ".gmvault/state.json",
    "Home.md"
  ],
  "replaceOnUpdate": [
    "Home.md"
  ],
  "contractualNames": [
    "Active.md",
    "World.md",
    "Campaign.md",
    "Party.md",
    "Run.md",
    "State.md",
    "Dashboard.md",
    "Radar.md",
    "World Day.md"
  ],
  "runtimeReadOnlyAllowlist": [
    "_system/"
  ],
  "asciiAllowlist": [
    "_system/obsidian/plugins/calendarium/main.js",
    "_system/obsidian/themes/Fancy-a-Story/theme.css",
    "_system/obsidian/plugins/obsidian-style-settings/main.js",
    "_system/obsidian/plugins/obsidian-style-settings/styles.css"
  ],
  "referenceFolders": [
    "Library/*/Mechanics",
    "Library/*/Worlds/*/Lore/Creatures",
    "Library/*/Campaigns/*/Lore/Creatures",
    "Library/Mechanics/*/Spells",
    "Library/Mechanics/*/Bestiary",
    "Library/Mechanics/*/Items",
    "Library/*/Mechanics/Bestiary",
    "Campaigns/*/Mechanics/Bestiary",
    "Worlds/*/Lore/Creatures"
  ],
  "neverTouch": [
    ".obsidian/workspace.json",
    ".obsidian/workspace-mobile.json",
    ".obsidian/plugins/table-tools/data.json",
    ".obsidian/plugins/calendarium/data.json"
  ],
  "managedObsidian": [
    {
      "path": "app.json",
      "keys": [
        "alwaysUpdateLinks",
        "attachmentFolderPath"
      ]
    },
    {
      "path": "community-plugins.json",
      "merge": true
    },
    {
      "path": "plugins/templater-obsidian/data.json",
      "keys": [
        "templates_folder",
        "user_scripts_folder",
        "folder_templates",
        "file_templates",
        "trigger_on_file_creation",
        "trigger_on_file_creation_mode",
        "ignore_folders_on_creation"
      ]
    },
    {
      "path": "plugins/templater-obsidian/manifest.json",
      "keys": [
        "id",
        "name",
        "version",
        "minAppVersion",
        "description",
        "author",
        "isDesktopOnly"
      ]
    },
    {
      "path": "plugins/templater-obsidian/main.js",
      "keys": null
    },
    {
      "path": "plugins/calendarium/manifest.json",
      "keys": [
        "id",
        "name",
        "version",
        "minAppVersion",
        "description",
        "author",
        "isDesktopOnly"
      ]
    },
    {
      "path": "plugins/calendarium/main.js",
      "keys": null
    },
    {
      "path": "plugins/calendarium/styles.css",
      "keys": null
    },
    {
      "path": "plugins/obsidian-style-settings/manifest.json",
      "keys": [
        "id",
        "name",
        "version",
        "minAppVersion",
        "description",
        "author",
        "isDesktopOnly"
      ]
    },
    {
      "path": "plugins/obsidian-style-settings/main.js",
      "keys": null
    },
    {
      "path": "plugins/obsidian-style-settings/styles.css",
      "keys": null
    },
    {
      "path": "snippets/gmvault-fonts.css",
      "keys": null
    },
    {
      "path": "snippets/gmvault-fantasy.css",
      "keys": null
    },
    {
      "path": "plugins/table-tools/manifest.json",
      "keys": [
        "id",
        "name",
        "version",
        "minAppVersion",
        "description",
        "author",
        "isDesktopOnly"
      ]
    },
    {
      "path": "plugins/table-tools/main.js",
      "keys": []
    },
    {
      "path": "plugins/table-tools/styles.css",
      "keys": []
    }
  ],
  "folders": [
    {
      "path": "Parties",
      "noTemplate": true
    },
    {
      "path": "Runs",
      "noTemplate": true
    },
    {
      "path": "Library/Assets",
      "noTemplate": true
    },
    {
      "path": "Calendar",
      "noTemplate": true
    },
    {
      "path": "Archive",
      "noTemplate": true
    },
    {
      "path": "_local/templates",
      "noTemplate": true
    },
    {
      "path": "_local/scripts",
      "noTemplate": true
    }
  ],
  "templateRules": [
    {"pattern":"^Library/[^/]+/","template":"auto.md"},
    {"pattern":"^Runs/[^/]+/Run\\.md$","template":"run.md"},
    {"pattern":"^Runs/[^/]+/Sessions/[^/]+\\.md$","template":"session.md"},
    {"pattern":"^Runs/[^/]+/[^/]+\\.md$","template":"session.md"},
    {"pattern":"^Parties/[^/]+/Party\\.md$","template":"party.md"},
    {"pattern":"^Parties/[^/]+/(?!Party\\.md$)[^/]+\\.md$","template":"pc.md"},
    {"pattern":"^Campaigns/","template":"auto.md"},
    {"pattern":"^Worlds/","template":"auto.md"}
  ],
  "defaults": {
    "system": "generic",
    "calendar": "Calendar"
  },
  "legacyContentRoots": [
    "Worlds",
    "Campaigns"
  ]
}
