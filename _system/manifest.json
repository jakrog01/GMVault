{
  "release": {"repo":"jakrog01/GMVault", "asset":"GMVault.zip", "api":"https://api.github.com"},
  "releaseInclude": ["_system", "_local", ".obsidian", ".gmvault/plugin-build.json", "Worlds", "Campaigns", "Parties", "Runs", "Library", "Calendar", "Archive", "Active.md", "Home.md", ".gitignore"],
  "releaseExclude": [".obsidian/workspace.json", ".obsidian/workspace-mobile.json", ".obsidian/plugins/table-tools/data.json"],
  "contentRoots": ["Worlds", "Campaigns", "Parties", "Runs", "Library", "Calendar", "Archive"],
  "ownedGlobs": ["_system/**", ".obsidian/**", ".gmvault/state.json", "Home.md"],
  "replaceOnUpdate": ["Home.md"],
  "contractualNames": ["Active.md", "World.md", "Campaign.md", "Party.md", "Run.md", "State.md", "Dashboard.md", "Radar.md", "World Day.md"],
  "runtimeReadOnlyAllowlist": ["_system/"],
  "asciiAllowlist": ["_system/obsidian/plugins/calendarium/main.js", "_system/obsidian/themes/Fancy-a-Story/theme.css", "_system/obsidian/plugins/obsidian-style-settings/main.js", "_system/obsidian/plugins/obsidian-style-settings/styles.css"],
  "referenceFolders": ["Library/Mechanics/*/Spells", "Library/Mechanics/*/Bestiary", "Library/Mechanics/*/Items", "Library/*/Mechanics/Spells", "Library/*/Mechanics/Bestiary", "Library/*/Mechanics/Items"],
  "neverTouch": [".obsidian/workspace.json", ".obsidian/workspace-mobile.json", ".obsidian/plugins/table-tools/data.json", ".obsidian/plugins/calendarium/data.json"],
  "managedObsidian": [
    {"path":"app.json", "keys":["alwaysUpdateLinks", "attachmentFolderPath"]},
    {"path":"community-plugins.json", "merge":true},
    {"path":"plugins/templater-obsidian/data.json", "keys":["templates_folder", "user_scripts_folder", "folder_templates", "file_templates", "trigger_on_file_creation", "trigger_on_file_creation_mode", "ignore_folders_on_creation"]},
    {"path":"plugins/templater-obsidian/manifest.json", "keys":["id", "name", "version", "minAppVersion", "description", "author", "isDesktopOnly"]},
    {"path":"plugins/templater-obsidian/main.js", "keys":null},
    {"path":"plugins/calendarium/manifest.json", "keys":["id", "name", "version", "minAppVersion", "description", "author", "isDesktopOnly"]},
    {"path":"plugins/calendarium/main.js", "keys":null},
    {"path":"plugins/calendarium/styles.css", "keys":null},
    {"path":"plugins/obsidian-style-settings/manifest.json", "keys":["id", "name", "version", "minAppVersion", "description", "author", "isDesktopOnly"]},
    {"path":"plugins/obsidian-style-settings/main.js", "keys":null},
    {"path":"plugins/obsidian-style-settings/styles.css", "keys":null},
    {"path":"snippets/gmvault-fonts.css", "keys":null},
    {"path":"snippets/gmvault-fantasy.css", "keys":null},
    {"path":"plugins/table-tools/manifest.json", "keys":["id", "name", "version", "minAppVersion", "description", "author", "isDesktopOnly"]},
    {"path":"plugins/table-tools/main.js", "keys":[]},
    {"path":"plugins/table-tools/styles.css", "keys":[]}
  ],
  "folders": [
    {"path":"Worlds","noTemplate":true}, {"path":"Campaigns","noTemplate":true}, {"path":"Parties","noTemplate":true}, {"path":"Runs","noTemplate":true},
    {"path":"Library/Mechanics","noTemplate":true}, {"path":"Library/Assets","noTemplate":true},
    {"path":"Calendar","noTemplate":true}, {"path":"Archive","noTemplate":true}, {"path":"_local/templates","noTemplate":true}, {"path":"_local/scripts","noTemplate":true}
  ],
  "templateRules": [
    {"pattern":"^Library/[^/]+/Worlds/[^/]+/World\\.md$","template":"world.md"},
    {"pattern":"^Library/[^/]+/Worlds/[^/]+/NPCs/","template":"npc.md"},
    {"pattern":"^Library/[^/]+/Worlds/[^/]+/Locations/","template":"location.md"},
    {"pattern":"^Library/[^/]+/Worlds/[^/]+/Factions/","template":"faction.md"},
    {"pattern":"^Library/[^/]+/Worlds/[^/]+/Lore/","template":"lore.md"},
    {"pattern":"^Library/[^/]+/Worlds/[^/]+/Events/","template":"event.md"},
    {"pattern":"^Library/[^/]+/Mechanics/Spells/","template":"spell.md"},
    {"pattern":"^Library/[^/]+/Mechanics/Bestiary/","template":"creature.md"},
    {"pattern":"^Library/[^/]+/Mechanics/Items/","template":"item.md"},
    {"pattern":"^Library/[^/]+/Mechanics/Classes/","template":"rules.md"},
    {"pattern":"^Library/[^/]+/Mechanics/Races/","template":"rules.md"},
    {"pattern":"^Library/[^/]+/Mechanics/Backgrounds/","template":"rules.md"},
    {"pattern":"^Library/[^/]+/Mechanics/Feats/","template":"rules.md"},
    {"pattern":"^Library/[^/]+/Mechanics/Rules/","template":"rules.md"},
    {"pattern":"Campaigns/.+","template":"campaign.md"}, {"pattern":"Parties/.+","template":"party.md"},
    {"pattern":"Runs/.+","template":"run.md"}, {"pattern":"Library/Mechanics/.+/Spells/.+","template":"spell.md"},
    {"pattern":"Library/Mechanics/.+/Bestiary/.+","template":"creature.md"}, {"pattern":"Library/Mechanics/.+/Items/.+","template":"item.md"}
  ],
  "defaults": {"system":"generic", "calendar":"Calendar"}
}
