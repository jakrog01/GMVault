{
  "compilerOptions": {
    "module": "ESNext", "target": "ES2020", "moduleResolution": "bundler",
    "allowJs": true, "noImplicitAny": true, "strictNullChecks": true, "noUnusedLocals": true, "noUnusedParameters": true, "isolatedModules": true,
    "importHelpers": false, "lib": ["DOM", "ES2022"], "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
